@startuml
!theme plain

' =========================
' DTOs
' =========================
class RoutineRequest {
  + name: String
  + description: String
  + exercises: List<RoutineExerciseRequest>
}

class RoutineResponse {
  + id: UUID
  + name: String
  + description: String
  + exercises: List<RoutineExerciseResponse>
}

class RoutineListItem {
  + id: UUID
  + name: String
  + exerciseCount: Long
  + updatedAt: LocalDateTime
}

class RoutineExerciseRequest {
  + exerciseId: UUID
  + defaultRestSeconds: Integer
  + defaultSets: Integer
  + defaultReps: Integer
  + defaultWeightKg: Double
  + defaultDurationSeconds: Integer
  + defaultDistanceKm: Double
  + notes: String
}

class RoutineExerciseResponse {
  + exercise: ExerciseListItem
  + position: int
  + defaultRestSeconds: int
  + defaultSets: int
  + defaultReps: Integer
  + defaultWeightKg: Double
  + defaultDurationSeconds: Integer
  + defaultDistanceKm: Double
  + notes: String
}

' =========================
' DOMAIN
' =========================
class User {
  - id: UUID
  - username: String
  - email: String
  - role: Role
}

class Routine {
  - id: UUID
  - name: String
  - description: String
  + active: boolean
}

class RoutineExercise {
  - id: UUID
  - position: Integer
  - defaultRestSeconds: Integer
  - defaultSets: Integer
  - defaultReps: Integer
  - defaultWeightKg: Double
  - defaultDurationSeconds: Integer
  - defaultDistanceKm: Double
  - notes: String
}

class Exercise {
  - id: UUID
  - name: String
  - slug: String
  - description: String
  - category: Category
  - difficulty: Difficulty
}

' =========================
' REPOSITORY
' =========================
interface RoutineRepository {
  + existsByNameAndUserIdAndActiveTrue(name: String, userId: UUID): boolean
  + findAllByUserIdAndActiveTrueWithExerciseCount(userId: UUID, pageable: Pageable): Page<RoutineListItem>
  + findByIdAndActiveTrue(routineId: UUID): Optional<Routine>
}

' =========================
' SERVICES
' =========================
class RoutineService {
  - routineRepository: RoutineRepository
  - exerciseRepository: ExerciseRepository
  - routineMapper: RoutineMapper
  + getRoutinesByUserId(user: User, pageable: Pageable): Page<RoutineListItem>
  + getRoutineById(routineId: UUID, user: User): RoutineResponse
  + createRoutine(dto: RoutineRequest, user: User): RoutineResponse
  + updateRoutine(routineId: UUID, dto: RoutineRequest, user: User): RoutineResponse
  + deleteRoutine(routineId: UUID, user: User): void
  + addRoutineExercise(routineId: UUID, position: int, dto: RoutineExerciseRequest, user: User): RoutineResponse
  + updateRoutineExercise(routineId: UUID, position: int, dto: RoutineExerciseRequest, user: User): RoutineResponse
  + deleteRoutineExercise(routineId: UUID, position: int, user: User): void
}

' =========================
' MAPPER
' =========================
interface RoutineMapper {
  + toRoutineResponse(routine: Routine): RoutineResponse
  + toRoutineListItem(routine: Routine): RoutineListItem
}

interface RoutineExerciseMapper {
  + toRoutineExerciseResponse(routineExercise: RoutineExercise): RoutineExerciseResponse
}

' =========================
' CONTROLLER
' =========================
class RoutineController {
  - routineService: RoutineService
  + getRoutines(principal: UserDetailsImpl, pageable: Pageable): ResponseEntity<Page<RoutineListItem>>
  + getRoutine(routineId: UUID, principal: UserDetailsImpl): ResponseEntity<RoutineResponse>
  + createRoutine(dto: RoutineRequest, principal: UserDetailsImpl): ResponseEntity<RoutineResponse>
  + updateRoutine(routineId: UUID, dto: RoutineRequest, principal: UserDetailsImpl): ResponseEntity<RoutineResponse>
  + deleteRoutine(routineId: UUID, principal: UserDetailsImpl): ResponseEntity<Void>
  + addRoutineExercise(routineId: UUID, position: int, dto: RoutineExerciseRequest, principal: UserDetailsImpl): ResponseEntity<RoutineResponse>
  + updateRoutineExercise(routineId: UUID, position: int, dto: RoutineExerciseRequest, principal: UserDetailsImpl): ResponseEntity<RoutineResponse>
  + deleteRoutineExercise(routineId: UUID, position: int, principal: UserDetailsImpl): ResponseEntity<Void>
}

' =========================
' COMPOSITION
' =========================
RoutineController *-- RoutineService
RoutineService *-- RoutineRepository
RoutineService *-- ExerciseRepository
RoutineService *-- RoutineMapper
RoutineMapper *-- RoutineExerciseMapper

' =========================
' ASSOCIATIONS
' =========================
Routine "1" *-- "0..*" RoutineExercise : exercises
Routine "1" *-- "1" User : user
RoutineExercise "1" *-- "1" Exercise : exercise
RoutineExercise "1" *-- "1" Routine : routine

' =========================
' DEPENDENCIES
' =========================
RoutineController ..> RoutineResponse : <<uses>>
RoutineController ..> RoutineListItem : <<uses>>
RoutineController ..> RoutineRequest : <<uses>>
RoutineController ..> RoutineExerciseRequest : <<uses>>
RoutineService ..> RoutineResponse : <<creates>>
RoutineService ..> RoutineListItem : <<creates>>
RoutineService ..> ResourceNotFoundException : <<throws>>
RoutineService ..> ResourceAlreadyExistsException : <<throws>>
RoutineService ..> ValidationException : <<throws>>

@enduml