@startuml auth-architecture

title Auth Module Architecture

skinparam componentStyle uml2
skinparam backgroundColor #FEFEFE
skinparam component {
    BackgroundColor #D6E4F0
    BorderColor #4A90D9
}
skinparam database {
    BackgroundColor #E8E8E8
    BorderColor #888888
}
skinparam node {
    BackgroundColor #F0F0F0
    BorderColor #AAAAAA
}
skinparam package {
    BackgroundColor #F5F5F5
    BorderColor #CCCCCC
}

package "auth module" as authmod {

    component "RegistrationController\n(/api/v1/auth)" as regctrl {
    }

    component "SessionController\n(/api/v1/auth)" as sessctrl {
    }

    component "CredentialsController\n(/api/v1/auth)" as credctrl {
    }

    component "RegistrationService" as regsvc {
    }

    component "SessionService" as sesssvc {
    }

    component "CredentialsService" as credsvc {
    }

    component "VerificationTokenService" as verifsvc {
    }

    component "JwtService" as jwt {
    }

    component "OpaqueTokens" as opaque {
    }

    component "RefreshTokenRepository" as rtrepo {
    }

    component "VerificationTokenRepository" as vtrepo {
    }

    component "RefreshCookieFactory" as cookie {
    }

    database "RefreshToken Entity\n(refresh_tokens table)" as rt {
    }

    database "VerificationToken Entity\n(verification_tokens table)" as vt {
    }
}

package "user module" as usermod {
    database "User Entity\n(users table)" as user {
    }
}

package "security module" as secmod {
    component "UserDetailsImpl" as udi {
    }

    component "JwtFilter" as jf {
    }
}

package "common module" as commod {
    component "Exception Types\n(BadRequest,\nInvalidJwt,\nResourceNotFound,\nResourceAlreadyExists)" as exc {
    }
}

package "config" as cfg {
    component "SecurityConfig\n(public: register, verify-email,\nresend-verification, login,\nforgot/reset-password, refresh, logout)" as sc {
    }

    component "OpenApiConfig\n(Bearer Auth scheme)" as oc {
    }
}

skinparam arrowColor #4A90D9
skinparam arrowFontSize 10

HTTPRequest -[hidden]> regctrl : HTTP\nRequest
HTTPRequest -[hidden]> sessctrl : HTTP\nRequest
HTTPRequest -[hidden]> credctrl : HTTP\nRequest

sc ..> regctrl : permitAll
sc ..> sessctrl : permitAll
sc ..> credctrl : permitAll\n(forgot/reset)
jf ..> regctrl : filters\nall requests

regctrl --> regsvc : 1. call\nuse case
sessctrl --> sesssvc : 1. call\nuse case
credctrl --> credsvc : 1. call\nuse case

regsvc --> verifsvc : 2. issue\nverification token
sesssvc --> jwt : 2. generate /\nparse access token
sesssvc --> opaque : 3. issue opaque\nrefresh token
sesssvc --> rtrepo : 4. persist /\nquery refresh tokens
sesssvc --> cookie : 5. build\nrefresh cookie
credsvc --> verifsvc : 2. consume\nverification token
credsvc --> rtrepo : 3. revoke\ntoken families
verifsvc --> vtrepo : 4. persist /\nquery tokens
rtrepo --> rt : 5. entity\nmapping
vtrepo --> vt : 5. entity\nmapping
sesssvc --> user : 6. lookup\nuser by email
user --> usermod : entity\nreference
regsvc --> exc : throws\nexceptions

cfg ..> sc : security\nfilter chain
cfg ..> oc : global\nsecurity\nrequirement

note right of jwt
  Access Token:
  - short-lived, stateless
  - JWT, contains user
    identity + roles
end note

note right of opaque
  Refresh Token:
  - opaque random value
  - only its hash is stored
  - carries familyId server-side
end note

note bottom of rt
  Token rotation:
  each refresh revokes
  the old token, persists
  a new one. Reuse revokes
  the whole family.
end note

@enduml
