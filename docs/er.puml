@startuml
!theme plain

title Entity-Relationship Diagram

entity "users" {
    * id : UUID <<PK>>
    --
    * username : VARCHAR <<UK>>
    * email : VARCHAR <<UK>>
    * password_hash : VARCHAR
    * role : VARCHAR
    * email_verified : BOOLEAN
    * timezone : VARCHAR
    * profile_picture_key : VARCHAR
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
}

entity "refresh_tokens" {
    * id : UUID <<PK>>
    --
    * hash : BYTEA <<UK>>
    * family_id : UUID
    * revoked : BOOLEAN
    * expires_at : TIMESTAMPTZ
    * user_id : UUID <<FK>>
}

entity "verification_tokens" {
    * id : UUID <<PK>>
    --
    * subject_id : UUID <<FK>>
    * hash : BYTEA
    * purpose : VARCHAR
    * expires_at : TIMESTAMPTZ
    * used_at : TIMESTAMPTZ
    * created_at : TIMESTAMPTZ
}

entity "muscles" {
    * id : UUID <<PK>>
    --
    * name : VARCHAR <<UK>>
    * slug : VARCHAR <<UK>>
    * body_region : VARCHAR
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
}

entity "muscle_assets" {
    * id : UUID <<PK>>
    --
    * object_key : VARCHAR <<UK>>
    * variant : VARCHAR
    * view : VARCHAR
    * created_at : TIMESTAMP
    * updated_at : TIMESTAMP
}

entity "muscle_asset_mappings" {
    * muscle_id : UUID <<PK>> <<FK>>
    * muscle_asset_id : UUID <<PK>> <<FK>>
}

entity "exercises" {
    * id : UUID <<PK>>
    --
    * name : VARCHAR <<UK>>
    * slug : VARCHAR <<UK>>
    * description : TEXT
    * instructions : TEXT[]
    * media_object_key : VARCHAR <<UK>>
    * thumbnail_object_key : VARCHAR <<UK>>
    * category : VARCHAR
    * difficulty : VARCHAR
    * active : BOOLEAN
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
}

entity "exercise_muscles" {
    * exercise_id : UUID <<PK>> <<FK>>
    * muscle_id : UUID <<PK>> <<FK>>
    --
    * impact_level : VARCHAR
}

entity "routines" {
    * id : UUID <<PK>>
    --
    * name : VARCHAR
    * description : TEXT
    * active : BOOLEAN
    * user_id : UUID <<FK>>
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
    ..
    UK : (name, user_id)
}

entity "routine_exercises" {
    * id : UUID <<PK>>
    --
    * routine_id : UUID <<FK>>
    * exercise_id : UUID <<FK>>
    * position : INT
    * default_rest_seconds : INT
    * default_sets : INT
    default_reps : INT
    default_weight_kg : DOUBLE PRECISION
    default_duration_seconds : INT
    default_distance_km : DOUBLE PRECISION
    notes : TEXT
    ..
    UK : (routine_id, position)
}

entity "workout_sessions" {
    * id : UUID <<PK>>
    --
    * user_id : UUID <<FK>>
    routine_id : UUID <<FK>> NULL
    * status : VARCHAR
    * started_at : TIMESTAMPTZ
    completed_at : TIMESTAMPTZ
    notes : TEXT
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
}

entity "session_exercises" {
    * id : UUID <<PK>>
    --
    * session_id : UUID <<FK>>
    * exercise_id : UUID <<FK>>
    * position : INT
    notes : TEXT
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
    ..
    UK : (session_id, position)
}

entity "session_sets" {
    * id : UUID <<PK>>
    --
    * session_exercise_id : UUID <<FK>>
    * set_number : INT
    reps : INT
    weight_kg : DOUBLE PRECISION
    duration_seconds : INT
    distance_km : DOUBLE PRECISION
    * completed : BOOLEAN
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
    ..
    UK : (session_exercise_id, set_number)
}

entity "progress_records" {
    * id : UUID <<PK>>
    --
    * user_id : UUID <<FK>>
    * recorded_at : DATE
    * weight_kg : DOUBLE PRECISION
    body_fat_percentage : DOUBLE PRECISION
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
    ..
    UK : (user_id, recorded_at)
}

"users" ||--o{ "refresh_tokens" : "has"
"users" ||--o{ "verification_tokens" : "has"
"users" ||--o{ "routines" : "has"
"users" ||--o{ "workout_sessions" : "has"
"users" ||--o{ "progress_records" : "has"
"routines" ||--o{ "routine_exercises" : "has"
"routines" ||--o{ "workout_sessions" : "starts"
"exercises" ||--o{ "routine_exercises" : "used in"
"exercises" ||--o{ "session_exercises" : "performed in"
"workout_sessions" ||--o{ "session_exercises" : "has"
"session_exercises" ||--o{ "session_sets" : "has"
"exercises" ||--o{ "exercise_muscles" : "targets"
"muscles" ||--o{ "exercise_muscles" : "targeted by"
"muscles" ||--o{ "muscle_asset_mappings" : "illustrated by"
"muscle_assets" ||--o{ "muscle_asset_mappings" : "maps to"

note bottom of muscle_assets
  Legacy column content_type is
  no longer mapped by the entity.
end note

@enduml
