@startuml
!theme plain

entity "users" {
    * id : UUID <<PK>>
    --
    * username : VARCHAR <<UK>>
    * email : VARCHAR <<UK>>
    * password_hash : VARCHAR
    * role : VARCHAR
    * created_at : TIMESTAMP
    * updated_at : TIMESTAMP
}

entity "tokens" {
    * jti : UUID <<PK>>
    --
    * family_id : UUID
    * revoked : BOOLEAN
    * expires_at : TIMESTAMP
    * user_id : UUID <<FK>>
}

entity "muscles" {
    * id : UUID <<PK>>
    --
    * name : VARCHAR <<UK>>
    * slug : VARCHAR <<UK>>
    * body_region : VARCHAR
    * created_at : TIMESTAMP
    * updated_at : TIMESTAMP
}

entity "exercises" {
    * id : UUID <<PK>>
    --
    * name : VARCHAR <<UK>>
    * slug : VARCHAR <<UK>>
    * description : VARCHAR
    * category : VARCHAR
    * difficulty : VARCHAR
    * active : BOOLEAN
    * created_at : TIMESTAMP
    * updated_at : TIMESTAMP
}

entity "exercise_muscles" {
    * exercise_id : UUID <<FK>> <<PK>>
    * muscle_id : UUID <<FK>> <<PK>>
    --
    * impact_level : VARCHAR
}

entity "routines" {
    * id : UUID <<PK>>
    --
    * name : VARCHAR
    * description : TEXT
    * active : BOOLEAN
    * user_id : UUID <<FK>>
    * created_at : TIMESTAMP
    * updated_at : TIMESTAMP
    ..
    UK : (name, user_id)
}

entity "routine_exercises" {
    * id : UUID <<PK>>
    --
    * routine_id : UUID <<FK>>
    * exercise_id : UUID <<FK>>
    * position : INT
    * default_rest_seconds : INT
    * default_sets : INT
    default_reps : INT
    default_weight_kg : DOUBLE PRECISION
    default_duration_seconds : INT
    default_distance_km : DOUBLE PRECISION
    notes : TEXT
    ..
    UK : (routine_id, position)
}

"exercises" ||--o{ "exercise_muscles" : "has"
"muscles" ||--o{ "exercise_muscles" : "has"
"users" ||--o{ "tokens" : "has"
"users" ||--o{ "routines" : "has"
"routines" ||--o{ "routine_exercises" : "has"
"exercises" ||--o{ "routine_exercises" : "used in"

@enduml
