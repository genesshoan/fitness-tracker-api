@startuml exercise-architecture

title Exercise Module Architecture

skinparam componentStyle uml2
skinparam backgroundColor #FEFEFE
skinparam component {
    BackgroundColor #D6E4F0
    BorderColor #4A90D9
}
skinparam interface {
    BackgroundColor #E8F4E8
    BorderColor #5AA55A
}
skinparam database {
    BackgroundColor #E8E8E8
    BorderColor #888888
}
skinparam node {
    BackgroundColor #F0F0F0
    BorderColor #AAAAAA
}
skinparam package {
    BackgroundColor #F5F5F5
    BorderColor #CCCCCC
}

package "exercise module" as exmod {

    component "ExerciseController" as exc {
    }

    component "MuscleController" as muc {
    }

    interface "ExerciseUseCase" as exuc {
    }

    interface "ExerciseQueryUseCase" as exquc {
    }

    interface "MuscleUseCase" as muuc {
    }

    interface "MuscleAssetUseCase" as mauc {
    }

    component "ExerciseService" as exs {
    }

    component "MuscleService" as mus {
    }

    component "MuscleAssetService" as mas {
    }

    component "ExerciseRepository" as exr {
    }

    component "MuscleRepository" as mur {
    }

    component "MuscleAssetRepository" as mar {
    }

    component "ExerciseResultMapper" as erm {
    }

    component "MuscleResultMapper" as mrm {
    }

    component "ExerciseMapper" as exm {
    }

    component "MuscleMapper" as mm {
    }

    component "CatalogAssetUrlProvider" as caup {
    }

    database "Exercise Entity\n(exercises table)" as ex {
    }

    database "ExerciseMuscle Entity\n(exercise_muscles table)" as exm {
    }

    database "Muscle Entity\n(muscles table)" as mus {
    }

    database "MuscleAsset Entity\n(muscle_assets table)" as musa {
    }
}

package "other modules" as othmod {
    component "RoutineService" as ros {
    }

    component "WorkoutSessionService" as wos {
    }

    component "StatsService" as sts {
    }
}

package "common module" as commod {
    component "CursorPage / CursorPageRequest" as cp {
    }

    component "BaseEntity\n(id, createdAt, updatedAt)" as be {
    }
}

package "security module" as secmod {
    component "JwtFilter" as jf {
    }

    component "SecurityConfig\n(authenticated: /api/v1/exercises/**)" as sc {
    }
}

skinparam arrowColor #4A90D9
skinparam arrowFontSize 10

HTTPRequest -[hidden]> exc : HTTP\nRequest
sc ..> exc : authenticated\n@ /api/v1/exercises/**

exc --> exuc : 1. call use case
exuc --> exs : 2. implemented by
exs --> exr : 3. query\nfiltered exercises
exr --> ex : 4. entity\nmapping
exr --> exm : 5. join entity\nmapping
exr --> mus : 6. muscle\nmapping

exs --> erm : 7. map to results
erm --> caup : 8. resolve asset URLs
exc --> exm : 9. map results to DTOs
exm --> mm : 10. map muscle results

muc --> muuc : 1. call use case
muuc --> mus : 2. implemented by
mus --> mur : 3. query muscles
mus --> mrm : 4. map to results
muc --> mm : 5. map results to DTOs

ros --> exquc : read exercises
wos --> exquc : read exercises
sts --> exquc : exercise existence
sts --> mauc : muscle asset URLs
exquc --> exs : implemented by
mauc --> mas : implemented by
mas --> mar : 6. query base assets
mas --> caup : 7. resolve asset URLs

note right of exuc
  Inbound use cases:
  - ExerciseUseCase
    catalog reads + ADMIN writes
  - ExerciseQueryUseCase
    read view for other modules
  - MuscleUseCase
  - MuscleAssetUseCase
end note

note right of exs
  ExerciseService:
  - getAllExercises()
    cursor pagination + filters
  - getExerciseBySlug()
    detail with muscles
  - findByIds()
    exercises keyed by id
end note

note bottom of exm
  ExerciseMuscle:
  - composite key (exerciseId, muscleId)
  - impactLevel: PRIMARY / SECONDARY /
    STABILIZER
end note

note right of ex {
  Exercise:
  - soft delete via active flag
  - category: STRENGTH / CARDIO / MOBILITY
  - difficulty: BEGINNER / INTERMEDIATE /
    ADVANCED
}

@enduml
