@startuml
!theme plain
actor Client
participant UserController
participant UserService
participant UserRepository
participant PasswordEncoder
participant ObjectStoragePort

group Get profile
  Client -> UserController : GET /user/me
  UserController -> UserService : getProfile(authenticated user)
  UserService -> UserRepository : findById(userId)
  UserRepository --> UserService : User
  UserService -> ObjectStoragePort : getPresignedUrl(profilePictureKey)
  ObjectStoragePort --> UserService : temporary URL
  UserService --> Client : UserResponse
end

group Upload or replace profile picture
  Client -> UserController : PUT /user/me/profile-picture (multipart)
  UserController -> ProfilePictureUseCase : uploadProfilePicture(userId, file)
  ProfilePictureUseCase -> ObjectStoragePort : upload(stable user key)
  ObjectStoragePort --> ProfilePictureUseCase : stored
  ProfilePictureUseCase --> Client : ProfilePictureResponse
end

group Change username
  Client -> UserController : PUT /user/me/username
  UserController -> UserService : changeUsername(userId, request)
  UserService -> UserRepository : findById(userId)
  UserService -> UserRepository : persist new username
  UserService --> Client : 204 No Content
end

note over Client, UserService
  Password changes belong to the auth module:
  PATCH /api/v1/auth/password
end note
@enduml
