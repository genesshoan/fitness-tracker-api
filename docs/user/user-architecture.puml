@startuml
!theme plain

class UserController
class UserService
interface UserRepository
class UserMapper
class User
class UserResponseDTO
class ProfilePictureResponseDTO
class ChangePasswordRequestDTO
class ChangeUsernameRequestDTO
class PasswordEncoder
interface ProfilePictureUseCase
interface ObjectStoragePort

UserController --> UserService
UserService --> UserRepository
UserService --> UserMapper
UserService --> PasswordEncoder
UserService --> ProfilePictureUseCase
ProfilePictureUseCase --> ObjectStoragePort
UserRepository --> User
UserMapper --> UserResponseDTO
UserController ..> ProfilePictureResponseDTO
UserController ..> ChangePasswordRequestDTO
UserController ..> ChangeUsernameRequestDTO

note right of UserService
  Identity comes from the
  authenticated principal.
  Passwords are encoded.
end note
@enduml
