# Database
DB_URL=jdbc:postgresql://localhost:5432/fitness_db
DB_USERNAME=your_db_user
DB_PASSWORD=change_me
DB_NAME=fitness_db

# JWT (access token only)
SECRET_KEY=change_me_long_random_string
JWT_KEY_EXPIRATION=15m

# Refresh token (opaque token)
JWT_REFRESH_KEY_EXPIRATION=7d
REFRESH_COOKIE_SECURE=false

# Email verification
VERIFICATION_EMAIL_EXPIRATION=24h

# Password reset
PASSWORD_RESET_EXPIRATION=1h

# Spring
SPRING_PROFILES_ACTIVE=dev

# Image version (for build-arg)
APP_VERSION=0.0.1

# Object storage (S3 compatible, e.g. Backblaze B2)
STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
STORAGE_REGION=us-east-005
STORAGE_BUCKET=your_bucket_name

# B2: keyID
STORAGE_ACCESS_KEY=change_me

# B2: applicationKey
STORAGE_SECRET_KEY=change_me
STORAGE_PATH_STYLE=true
STORAGE_PRESIGNED_URL_EXPIRATION=1h

# Profile pictures
PROFILE_PICTURE_MAX_SIZE=5MB
PROFILE_PICTURE_ALLOWED_TYPES=image/jpeg,image/png,image/webp
PROFILE_PICTURE_MIN_DIMENSION=64
PROFILE_PICTURE_MAX_PIXELS=25000000
PROFILE_PICTURE_OUTPUT_SIZE=512
PROFILE_PICTURE_OUTPUT_QUALITY=0.85
PROFILE_PICTURE_OUTPUT_FORMAT=jpeg

# Email (SMTP)
MAIL_HOST=change-provider
MAIL_PORT=587
MAIL_USERNAME=change-login
MAIL_PASSWORD=change-smtp-key
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Fitness Tracker
MAIL_LOGO_URL=

# Frontend (mail links)
FRONTEND_URL=http://localhost:5173
